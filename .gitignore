echo ".DS_Store" >> .gitignore
echo "**/.env" >> .gitignore
git add .gitignore
git commit -m "Ignore .env and .DS_Store everywhere"
git status
.env
.env.*
!.env.example
.DS_Store
# Environment files - never commit secrets
.env
.env.*
**/.env
**/.env.*

# Allow example environment templates
!.env.example
!**/.env.example

# Dependencies
node_modules/
vendor/

# Build outputs
dist/
build/

# Logs
*.log

# OS files
.DS_Store